(defwidget top-bar-widget[]
  (box :orientation "horizontal" :space-evenly true :class "bar"
    (image :path "/home/amor_iii/.config/eww/images/top.png"
    :image-width 1900 )
  )
)

(defwindow top-image-layout
  :monitor "HDMI-A-2"
  :geometry (geometry
    :x "0%"
    :y "2%"
    :width "100%"
    :height "0%"
  :anchor "top center")
  :stacking "bg"
  :exclusive "true"
  :anchor "top center"
  (top-bar-widget)
)
