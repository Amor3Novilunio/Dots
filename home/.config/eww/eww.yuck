; ------------------------------
;  Bottom Bar Layout
; ------------------------------

(defpoll active_ws :interval "0.1s"
`hyprctl activeworkspace -j | jq -r '.name'`)

(defwidget workspaces-widget []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "start"
       :monitor "eDP-2"

    ; workspace 1
    (button :onclick "hyprctl dispatch workspace 1"
      (image
        :path { active_ws == "1" 
          ? "/home/amor_iii/.config/eww/images/cyberpunk/wsActive.png"
          : "/home/amor_iii/.config/eww/images/cyberpunk/wsInActive.png" }
        :image-width 24 :image-height 24))

    ; workspace 2
    (button :onclick "hyprctl dispatch workspace 2"
      (image
        :path { active_ws == "2" 
          ? "/home/amor_iii/.config/eww/images/cyberpunk/wsActive.png"
          : "/home/amor_iii/.config/eww/images/cyberpunk/wsInActive.png" }
        :image-width 24 :image-height 24))

    ; workspace 3
