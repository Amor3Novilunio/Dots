; ------------------------------
;  Clock
; ------------------------------

(defpoll clock-fns :interval "1s" "date '+%I:%M:%S %p'")

(defwidget clock-widget []
  (box :class "clock-box"
    (label :text "${clock-fns}")
  )
)

(defwindow clock
  :monitor "HDMI-A-1"
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "10%"
    :height "10px"
  :anchor "top right")
  :stacking "bg"
  :anchor "top right"
  (clock-widget)
)



; ------------------------------
;  Top Bar Layout
; ------------------------------

(defwidget short-bar-widget[]
  (box :orientation "horizontal" :space-evenly true :class "bar"
    (image :path "/home/amor_iii/.config/eww/images/cyberpunk/short_bar.png"
    :image-width 300 )
  )
)

(defwidget long-bar-widget[]
  (box :orientation "horizontal" :space-evenly true :class "bar"
    (image :path "/home/amor_iii/.config/eww/images/cyberpunk/long_bar.png"
    :image-width 800)
  )
)

(defpoll system-hostname :interval "30m" "hostname")

(defwidget hostname-widget []
  (label :text "${system-hostname}")
)

(defwindow hostname
  :monitor "eDP-2"
  :geometry (geometry
    :x "2.5%"
    :y "1%"
    :width "5%"
    :height "0%"
  :anchor "top right")
  :stacking "bg"
  :anchor "top right"
  (hostname-widget)
)

(defwindow menu-btn-closed
  :monitor "eDP-2"
  :geometry (geometry
    :x "-0.5%"
    :y "1%"
    :width "5%"
    :height "0%"
  :anchor "top left")
  :stacking "bg"
  :anchor "top left"
  "F1"
)

