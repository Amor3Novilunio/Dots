          ? "/home/amor_iii/.config/eww/images/cyberpunk/wsActive.png"
          : "/home/amor_iii/.config/eww/images/cyberpunk/wsInActive.png" }
        :image-width 24 :image-height 24))

    ; workspace 5
    (button :onclick "hyprctl dispatch workspace 5"
